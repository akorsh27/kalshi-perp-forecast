# Kalshi API Credentials
# Generate at https://demo.kalshi.co → Account & Security → API Keys
KALSHI_API_KEY_ID=your-api-key-id-uuid-here
KALSHI_PRIVATE_KEY_PATH=./keys/kalshi_private.key

# Environment: "demo" or "production"
KALSHI_ENV=demo

# Database path (relative to project root)
DATABASE_PATH=./data/kalshi_perps.db

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
